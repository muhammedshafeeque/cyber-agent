# ============================================
# Cyber Agent - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# cp sample.env .env

# ============================================
# Mistral AI Configuration (REQUIRED)
# ============================================
# Get your API key from: https://mistral.ai
MISTRAL_API_KEY=your_mistral_api_key_here

# ============================================
# ArangoDB Configuration (REQUIRED)
# ============================================
# Database hostname
ARANGO_HOST=localhost

# Database port (default: 8529)
ARANGO_PORT=8529

# Database username (default: root)
ARANGO_USER=root

# Database password
ARANGO_PASSWORD=your_arango_password

# Database name (default: cyber_security)
ARANGO_DB_NAME=cyber_security

# ============================================
# Application Configuration (OPTIONAL)
# ============================================
# Logging level: info, debug, warn, error (default: info)
LOG_LEVEL=info

# Working directory for storing tools, exploits, and logs (default: ./work)
WORK_DIR=./work

